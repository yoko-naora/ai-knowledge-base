# ═══════════════════════════════════════════════════════════════
#  AI知識庫 · 环境变量模板
#  ⚠️  安全警告：此文件仅为模板。所有实际密钥必须在 Netlify
#     Dashboard → Site Settings → Environment Variables 中设置。
#     绝对不要在代码中硬编码默认值或密钥！
# ═══════════════════════════════════════════════════════════════

# ── Stripe ─────────────────────────────────────────
# 获取: https://dashboard.stripe.com/apikeys → Secret key
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx

# Stripe Webhook Secret — 用于验证 webhook 签名
# 获取: Stripe Dashboard → Developers → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ── Resend (邮件服务) ──────────────────────────────
# 注册: https://resend.com → API Keys → 创建
# 免费额度: 100封/天
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Admin (管理页面密钥) ────────────────────────────
# ⚠️  必须设置！使用强随机密码（推荐 32+ 字符）
#     生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#     在 admin.html 登录页输入此密码即可查看客户数据
ADMIN_KEY=change-me-to-a-random-32-char-string

# ── Access Code (内容解锁码) ───────────────────────
# ⚠️  必须设置！购买后通过欢迎邮件发送给用户
#     生成: node -e "console.log(require('crypto').randomBytes(12).toString('hex'))"
ACCESS_CODE=change-me-to-a-random-code
