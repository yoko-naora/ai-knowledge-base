# Resend — email service (free: 100 emails/day)
# Sign up at https://resend.com → API Keys → create one
RESEND_API_KEY=re_xxxxxxxxxxxx

# Stripe — for fetching active subscribers (weekly update)
# Get from https://dashboard.stripe.com/apikeys → Secret key
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx

# Stripe Webhook Secret — for verifying webhook events
# Get from Stripe Dashboard → Developers → Webhooks → Add endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
